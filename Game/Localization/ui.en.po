msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

#. The combat button. Room for about ten characters.
msgid "ui.combat.attack"
msgstr "Attack"

msgid "ui.combat.player_won"
msgstr "Player wins."

msgid "ui.combat.player_lost"
msgstr "Player loses."

msgid "ui.combat.player_fled"
msgstr "The party got away."

#. Under the result of a fight won. {experience} is a number.
msgid "ui.combat.experience_gained"
msgstr "Gained {experience} experience."

#. One line per character. {name} is the character's name; {level}, a number.
msgid "ui.combat.level_reached"
msgstr "{name} reached level {level}."

#. One line per character down at the end of a fight won. {name} is the character's name.
msgid "ui.combat.was_down"
msgstr "{name} was down and gains nothing."

#. Two combatants of one kind told apart. {name} is the name; {letter}, A to D.
msgid "ui.combat.name_with_letter"
msgstr "{name} {letter}"

#. The fight's log. {round} is a number.
msgid "ui.combat.log.round"
msgstr "Round {round}"

#. {attacker} and {target} are combatants' names; {damage}, a number.
msgid "ui.combat.log.hit"
msgstr "{attacker} hits {target} for {damage}."

#. {attacker} and {target} are combatants' names; {damage}, a number.
msgid "ui.combat.log.critical"
msgstr "Critical hit! {attacker} hits {target} for {damage}."

#. {attacker} and {target} are combatants' names.
msgid "ui.combat.log.missed"
msgstr "{attacker} misses {target}."

#. {attacker} and {target} are combatants' names.
msgid "ui.combat.log.evaded"
msgstr "{target} evades {attacker}'s attack."

#. {name} is a combatant's name.
msgid "ui.combat.log.downed"
msgstr "{name} goes down."

#. {world} is a world's name (world.*); {cycle}, a number.
msgid "ui.hud.world_and_cycle"
msgstr "{world}  -  Cycle {cycle}"

#. The status screen. {level} is a number.
msgid "ui.status.level"
msgstr "Level {level}"

#. In place of the level, in the Real world. {age} is a number.
msgid "ui.status.age"
msgstr "Age {age}"

#. {experience} is what was gained since the last level; {to_next}, what the next one costs.
msgid "ui.status.experience"
msgstr "Experience {experience}/{to_next}"

#. In place of the experience, at the highest level.
msgid "ui.status.highest_level"
msgstr "Highest level"

#. {stat} is a stat's name (ui.stat.*); {current} and {max}, numbers.
msgid "ui.status.points"
msgstr "{stat}  {current}/{max}"

#. {stat} is a stat's name (ui.stat.*); {value}, a number.
msgid "ui.status.value"
msgstr "{stat}  {value}"

#. The stats' names. Short: they sit in a column beside their numbers.
msgid "ui.stat.health_points"
msgstr "HP"

msgid "ui.stat.mana_points"
msgstr "MP"

msgid "ui.stat.attack_damage"
msgstr "Attack"

msgid "ui.stat.armor"
msgstr "Armor"

msgid "ui.stat.agility"
msgstr "Agility"

msgid "ui.stat.luck"
msgstr "Luck"

msgid "ui.stat.hit_rate"
msgstr "Accuracy"
