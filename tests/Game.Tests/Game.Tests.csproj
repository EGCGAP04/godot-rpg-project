<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GodotRPGProject.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The engine-free game logic is compiled straight into this assembly instead of
    coming in through a ProjectReference to the Godot project. Two reasons:
    referencing the Godot project drags its source generators in here, which fail
    with CS8785 outside a Godot build; and compiling the source directly means a
    stray `using Godot;` in one of these files breaks this project, so the
    "Engine-Free Game Logic" convention is checked by the compiler rather than by
    review. Add a line here for every new engine-free class that gets tests.
  -->
  <ItemGroup>
    <Compile Include="..\..\Game\Combat\CombatResolver.cs" Link="GameLogic\CombatResolver.cs" />
    <Compile Include="..\..\Game\World\World.cs" Link="GameLogic\World.cs" />
    <Compile Include="..\..\Game\World\CyclePosition.cs" Link="GameLogic\CyclePosition.cs" />
    <Compile Include="..\..\Game\World\WorldUnlocks.cs" Link="GameLogic\WorldUnlocks.cs" />
    <Compile Include="..\..\Game\World\CycleProgression.cs" Link="GameLogic\CycleProgression.cs" />
    <Compile Include="..\..\Game\Player\Direction.cs" Link="GameLogic\Direction.cs" />
    <Compile Include="..\..\Game\Player\DirectionResolver.cs" Link="GameLogic\DirectionResolver.cs" />
    <Compile Include="..\..\Game\Dialogue\IFlagStore.cs" Link="GameLogic\IFlagStore.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagSyntaxException.cs" Link="GameLogic\FlagSyntaxException.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagTokenizer.cs" Link="GameLogic\FlagTokenizer.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagCondition.cs" Link="GameLogic\FlagCondition.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagConditionParser.cs" Link="GameLogic\FlagConditionParser.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagEffect.cs" Link="GameLogic\FlagEffect.cs" />
    <Compile Include="..\..\Game\Dialogue\FlagEffectParser.cs" Link="GameLogic\FlagEffectParser.cs" />
    <Compile Include="..\..\Game\Dialogue\DialogueNames.cs" Link="GameLogic\DialogueNames.cs" />
    <Compile Include="..\..\Game\Dialogue\Conversation.cs" Link="GameLogic\Conversation.cs" />
    <Compile Include="..\..\Game\Dialogue\ConversationReader.cs" Link="GameLogic\ConversationReader.cs" />
    <Compile Include="..\..\Game\Dialogue\DialogueRunner.cs" Link="GameLogic\DialogueRunner.cs" />
    <Compile Include="..\..\Game\Decisions\FlagCatalogue.cs" Link="GameLogic\FlagCatalogue.cs" />
    <Compile Include="..\..\Game\Shared\Scripts\DataFileException.cs" Link="GameLogic\DataFileException.cs" />
    <Compile Include="..\..\Game\Shared\Scripts\StrictJson.cs" Link="GameLogic\StrictJson.cs" />
  </ItemGroup>

</Project>
